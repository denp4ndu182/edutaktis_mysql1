# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure through your deployment platform's secret manager.
GEMINI_API_KEY=

# APP_URL: Public base URL of the deployed application.
# Configure according to the deployment environment.
APP_URL=

# DATABASE_URL: MySQL connection string.
# Local development example:
# mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
# Production example must use the database host and credentials
# provided by the hosting provider. Never commit real credentials.
DATABASE_URL=

# SESSION_SECRET: Required in production.
# Use a cryptographically random secret of at least 32 characters.
# Never reuse the development secret in production.
SESSION_SECRET=

# SMTP_CONFIGURATION (Optional - for email delivery):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Dedicated HMAC secret for generator quota hashing.
# Minimum 32 characters. Must be different from SESSION_SECRET.
# Use the same secret across all production application instances.
GENERATOR_QUOTA_SECRET=
