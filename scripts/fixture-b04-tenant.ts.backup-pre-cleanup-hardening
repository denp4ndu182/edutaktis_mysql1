import { randomUUID } from 'node:crypto';
import type { PrismaClient } from '@prisma/client';
import { hashPassword } from '../src/security/password';

const FIXTURE_MARKER = 'EDUTAKTIS_B04_TENANT_FIXTURE_V1';

export interface B04TenantFixture {
  marker: string;
  userId: string;
  email: string;
  institutionAId: string;
  institutionBId: string;
  institutionANpsn: string;
  institutionBNpsn: string;
}

function assertValidPassword(password: string): void {
  if (
    typeof password !== 'string' ||
    password.length < 12 ||
    !/[A-Z]/.test(password) ||
    !/[a-z]/.test(password) ||
    !/[0-9]/.test(password)
  ) {
    throw new Error(
      'B04_TEST_PASSWORD harus minimal 12 karakter dan mengandung huruf besar, huruf kecil, serta angka.'
    );
  }
}

export async function createB04TenantFixture(
  prisma: PrismaClient,
  password: string
): Promise<B04TenantFixture> {
  assertValidPassword(password);

  const unique = randomUUID();
  const userId = randomUUID();
  const institutionAId = randomUUID();
  const institutionBId = randomUUID();

  const email = `b04-${unique}@edutaktis.test`;
  const institutionANpsn = `B04A${unique.replace(/-/g, '').slice(0, 15)}`;
  const institutionBNpsn = `B04B${unique.replace(/-/g, '').slice(0, 15)}`;

  const passwordHash = await hashPassword(password);

  const fixture: B04TenantFixture = {
    marker: FIXTURE_MARKER,
    userId,
    email,
    institutionAId,
    institutionBId,
    institutionANpsn,
    institutionBNpsn,
  };

  await prisma.$transaction(async (tx) => {
    await tx.user.create({
      data: {
        id: userId,
        email,
        passwordHash,
        namaLengkap: 'B04 Tenant Integration Test',
        isActive: true,
        emailVerified: true,
      },
    });

    await tx.institution.createMany({
      data: [
        {
          id: institutionAId,
          npsn: institutionANpsn,
          namaResmi: `${FIXTURE_MARKER} Institution A`,
          namaSingkat: 'B04 Test A',
          jenjang: 'MA',
          jenisInstitusi: 'NEGERI',
          kementerianDinas: 'Kementerian Agama',
          alamatLengkap: 'Alamat sintetis untuk pengujian B04',
          kabupatenKota: 'Kota Pengujian',
          provinsi: 'Provinsi Pengujian',
        },
        {
          id: institutionBId,
          npsn: institutionBNpsn,
          namaResmi: `${FIXTURE_MARKER} Institution B`,
          namaSingkat: 'B04 Test B',
          jenjang: 'MA',
          jenisInstitusi: 'NEGERI',
          kementerianDinas: 'Kementerian Agama',
          alamatLengkap: 'Alamat sintetis untuk pengujian B04',
          kabupatenKota: 'Kota Pengujian',
          provinsi: 'Provinsi Pengujian',
        },
      ],
    });

    await tx.institutionMembership.createMany({
      data: [
        {
          userId,
          institutionId: institutionAId,
          role: 'TEACHER',
          status: 'ACTIVE',
          joinedAt: new Date('2026-01-01T00:00:00.000Z'),
        },
        {
          userId,
          institutionId: institutionBId,
          role: 'TEACHER',
          status: 'ACTIVE',
          joinedAt: new Date('2026-02-01T00:00:00.000Z'),
        },
      ],
    });
  });

  return fixture;
}

export async function cleanupB04TenantFixture(
  prisma: PrismaClient,
  fixture: B04TenantFixture
): Promise<void> {
  if (fixture.marker !== FIXTURE_MARKER) {
    throw new Error('Cleanup ditolak: marker fixture B04 tidak cocok.');
  }

  const institutionIds = [
    fixture.institutionAId,
    fixture.institutionBId,
  ];

  await prisma.$transaction(async (tx) => {
    const user = await tx.user.findUnique({
      where: { id: fixture.userId },
      select: { id: true, email: true },
    });

    if (!user) {
      const institutions = await tx.institution.findMany({
        where: {
          id: { in: institutionIds },
          npsn: {
            in: [
              fixture.institutionANpsn,
              fixture.institutionBNpsn,
            ],
          },
        },
        select: { id: true },
      });

      if (institutions.length > 0) {
        throw new Error(
          'Cleanup ditolak: user fixture tidak ditemukan, tetapi institusi fixture masih ada.'
        );
      }

      return;
    }

    if (user.email !== fixture.email) {
      throw new Error(
        'Cleanup ditolak: email user tidak cocok dengan fixture.'
      );
    }

    const institutions = await tx.institution.findMany({
      where: {
        id: { in: institutionIds },
      },
      select: { id: true, npsn: true },
    });

    const expectedNpsn = new Map([
      [fixture.institutionAId, fixture.institutionANpsn],
      [fixture.institutionBId, fixture.institutionBNpsn],
    ]);

    for (const institution of institutions) {
      if (expectedNpsn.get(institution.id) !== institution.npsn) {
        throw new Error(
          'Cleanup ditolak: identitas institusi tidak cocok dengan fixture.'
        );
      }
    }

    const memberships = await tx.institutionMembership.findMany({
      where: {
        userId: fixture.userId,
        institutionId: { in: institutionIds },
      },
      select: { institutionId: true },
    });

    if (
      memberships.length !== 2 ||
      !memberships.some((m) => m.institutionId === fixture.institutionAId) ||
      !memberships.some((m) => m.institutionId === fixture.institutionBId)
    ) {
      throw new Error(
        'Cleanup ditolak: struktur membership fixture tidak sesuai.'
      );
    }

    await tx.auditLog.deleteMany({
      where: {
        OR: [
          { userId: fixture.userId },
          { institutionId: { in: institutionIds } },
        ],
      },
    });

    await tx.userSession.deleteMany({
      where: { userId: fixture.userId },
    });

    await tx.institutionMembership.deleteMany({
      where: {
        userId: fixture.userId,
        institutionId: { in: institutionIds },
      },
    });

    await tx.user.delete({
      where: { id: fixture.userId },
    });

    await tx.institution.deleteMany({
      where: {
        id: { in: institutionIds },
        npsn: {
          in: [
            fixture.institutionANpsn,
            fixture.institutionBNpsn,
          ],
        },
      },
    });
  });
}
